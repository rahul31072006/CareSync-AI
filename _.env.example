DATABASE_URL=sqlite:///./caresync.db
SECRET_KEY=replace-with-a-random-secret-before-deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Prescription OCR; install Tesseract 5 with eng language data on the backend host.
OCR_ENABLED=1
TESSERACT_CMD=
OCR_MIN_CONFIDENCE=50
MAX_PDF_OCR_PAGES=10
UPLOAD_DIR=./private_uploads

# Optional key raises OpenFDA rate limits. RxNorm and OpenFDA work without a key.
OPENFDA_API_KEY=

# Public API URL used by the Vite frontend; contains no secrets
VITE_API_URL=http://localhost:8000
